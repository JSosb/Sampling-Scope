	(text "SENSE SCALING (12-bit ADC, 3.3 V reference)\nSENSE             PARTS                          FORMULA\n----------------  -----------------------------  -----------------------------------------\nI, all blocks     INA180A1 (G = 20) + 100R/100n  I = Vadc / (20 x Rshunt)   -> mA/V column\nV, 3.3 V rails    10k7 (rail) / 33k2 (GND)       V = 1.3223 x Vadc\nV, 4.4 / 5 / 6 V  33k2 (rail) / 33k2 (GND)       V = 2 x Vadc\nV, 24 V input     3x 33k2 (rail) / 10k7 (GND)    V = 10.31 x Vadc\nT, 10k NTC        10k NTC (3V3) / 10k (GND)      Rntc = 10k x (Vref / Vadc - 1)\n                                                 T[C] = 1 / (1/298.15 + ln(Rntc/10k) / B) - 273.15\nV, -5 V / -8 V    33k2 (rail) / 10k7 (to Vref)   V = 4.103 x Vadc - 3.103 x Vref"
		(exclude_from_sim no)
		(at 821.182 46.228 0)
		(effects
			(font
				(face "Courier New")
				(size 3.81 3.81)
				(bold yes)
			)
			(justify left)
		)
		(uuid "0fbdfdcf-bb96-4e16-9734-fece35b58534")
	)
